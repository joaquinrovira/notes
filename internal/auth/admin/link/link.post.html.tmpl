<!DOCTYPE html>
<html>

<head>
    <title>Admin - Generate Link</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/~/style.css">
    <title>Countdown</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            padding: 0;
            margin: 0;
        }


        .container {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        body {
            display: flex;
            flex-direction: column;
            padding: 20px;
        }

        button {
            padding: 10px 15px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        h1 {
            font-family: unset;
            text-decoration: underline;
        }

        a:has(>button) {
            display: contents;
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>Link Generated</h1>
        <a id="copy-link" href="{{ .Link }}"><button>Copy Link</button></a>
        <a href=""><button>Generate Another</button></a>
    </div>
</body>

<script>
document.getElementById('copy-link').onclick = function() {
    navigator.clipboard.writeText(this.href);
    window.alert("Link copied to clipboard!");
    return false
};
</script>

</html>